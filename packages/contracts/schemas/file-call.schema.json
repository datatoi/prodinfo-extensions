{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "read"
        },
        "input": {
          "type": "object",
          "properties": {
            "after": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          },
          "required": [
            "after"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "write"
        },
        "input": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
            },
            "mediaType": {
              "type": "string",
              "enum": [
                "text/plain",
                "text/csv",
                "application/json"
              ]
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            },
            "text": {
              "type": "string",
              "maxLength": 6000
            },
            "final": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "mediaType",
            "index",
            "text",
            "final"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "input"
      ],
      "additionalProperties": false
    }
  ]
}
