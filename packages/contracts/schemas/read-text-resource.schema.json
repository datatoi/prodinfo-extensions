{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "resource": {
      "type": "object",
      "properties": {
        "rootId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "resourceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/csv",
            "application/json"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        }
      },
      "required": [
        "rootId",
        "resourceId",
        "digest",
        "name",
        "mediaType",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "maxLength": 8192,
      "description": "Exact UTF-8 text up to 8192 bytes; no normalization. Display names are not filesystem paths."
    }
  },
  "required": [
    "resource",
    "text"
  ],
  "additionalProperties": false
}
